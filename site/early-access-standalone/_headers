# Netlify and Cloudflare Pages read this file.
#
# The HTML must never be cached hard: the launch date, the copy and the form
# wiring all live inside it, and a page pinned in a CDN for a year is a page you
# cannot correct. The images never change in place, so they can be cached
# for ever.

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

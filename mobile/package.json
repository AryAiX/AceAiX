{
  "name": "aceaix-mobile",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "dev:web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "expo export --platform web --clear",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test:smoke:web": "EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co EXPO_PUBLIC_SUPABASE_ANON_KEY=synthetic-anon-key-for-browser-smoke-only expo export --platform web --clear && node tests/e2e/smoke.mjs",
    "test:native-runtime": "node scripts/check-native-runtime.mjs",
    "doctor": "npx expo install --check && npx expo-doctor",
    "test:walkthrough": "npm run build:web && node tests/e2e/walkthrough.mjs",
    "test:multi-role": "npm run build:web && node tests/e2e/multi-role-scenarios.mjs",
    "backend:local": "../tools/local-supabase/start.sh",
    "db:test": "../supabase/tests/run-all.sh",
    "test:pipelines": "node tests/e2e/pipelines.mjs",
    "test:contract": "node tests/e2e/contract.mjs",
    "test:rls-adversarial": "node tests/e2e/rls-adversarial.mjs",
    "test:hosted-flows": "node tests/e2e/hosted-flows.mjs",
    "test:auth:live": "node tests/e2e/live-auth.mjs",
    "test:backend": "npm run db:test && npm run test:contract && npm run test:pipelines",
    "preview": "npm run build:web && node tests/e2e/record-demo.mjs && node tests/e2e/build-preview.mjs",
    "preview:check": "node tests/e2e/check-preview.mjs preview.html",
    "preview:hosted": "node tests/e2e/check-hosted.mjs preview.html"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-semi-condensed": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/saira-condensed": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.58.0",
    "abort-controller": "^3.0.0",
    "base64-arraybuffer": "^1.0.2",
    "country-state-city": "^3.2.1",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-compressor": "^2.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.61.1",
    "@react-native/metro-config": "^0.86.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
